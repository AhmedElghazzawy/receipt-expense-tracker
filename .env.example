# Free-tier Gemini key from Google AI Studio (no card needed)
GEMINI_API_KEY=
# Pick by eval, see docs/MODEL_ROUTING.md
LLM_LOCAL_MODEL=
LLM_CLOUD_MODEL=
# smart | local_only | cloud_first
PRIVACY_MODE=smart
CLOUD_DAILY_CAP=500
OLLAMA_HOST=http://127.0.0.1:11434
# Keep memory free on a 16 GB Mac
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=2m
# SQLite file (gitignored under data/)
DATABASE_PATH=./data/app.db
